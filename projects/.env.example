# Database
# Cách 1: dùng URL đầy đủ
DATABASE_URL="postgresql://postgres:2805@localhost:5432/apag?schema=public"
DIRECT_URL="postgresql://postgres:2805@localhost:5432/apag?schema=public"

# Cách 2: dùng biến rời; backend sẽ tự ghép URL nếu không có DATABASE_URL
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="apag"
DB_USER="postgres"
DB_PASS="2805"
DB_SCHEMA="public"
PRISMA_CONNECT_ON_INIT=true

# JWT
JWT_ACCESS_SECRET="replace-with-a-strong-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-different-strong-random-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
DUMMY_PASSWORD_HASH="$2b$12$replace-with-a-valid-bcrypt-dummy-password-hash"

# Server
BACKEND_PORT=5050
BACKEND_HOST="127.0.0.1"
FRONTEND_URL="http://localhost:3000"
STUDENT_PORTAL_URL="http://localhost:3000/login"
