# Copy to projects/.env. Never commit real credentials.
# Application
NODE_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5050
LOG_LEVEL=info
SWAGGER_ENABLED=true
PRISMA_CONNECT_ON_INIT=true

# Browser origins (comma-separated, without paths)
FRONTEND_URL="http://localhost:3000"
STUDENT_PORTAL_URL="http://localhost:3000/login"
PASSWORD_RESET_URL="http://localhost:3000/reset-password"

# Database: choose DB_* OR DATABASE_URL. Avoid configuring both.
# Runtime/seeds: DATABASE_URL > DIRECT_URL > DB_*.
# Prisma CLI: DIRECT_URL > DATABASE_URL > DB_* (direct connection for migrations).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=apag
DB_USER=postgres
DB_PASS="replace-with-your-database-password"
DB_SCHEMA=public
# Per process, including each API replica. Timeouts in milliseconds.
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=2000
# DATABASE_URL="postgresql://postgres:URL_ENCODED_PASSWORD@localhost:5432/apag?schema=public"
# DIRECT_URL="postgresql://postgres:URL_ENCODED_PASSWORD@localhost:5432/apag?schema=public"
# Docker DB port on the host; containers always use db:5432.
DB_PUBLISHED_PORT=15432

# JWT: replace both with distinct random secrets; durations require units.
JWT_ACCESS_SECRET="replace-with-a-strong-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-different-strong-random-refresh-secret"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Optional valid bcrypt hash; omit to use the built-in dummy comparison hash.
# DUMMY_PASSWORD_HASH="VALID_BCRYPT_HASH"

# SMTP is optional. Configure SMTP_HOST and SMTP_FROM together to enable email.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMTP_FROM_NAME="CSMTS"
SMTP_CLIENT_NAME=localhost

# Optional password for the K25 account seed scripts; never use in runtime.
# SEED_ACCOUNT_PASSWORD="replace-with-a-test-account-password"

# Optional PostgreSQL target for pnpm test:concurrency.
# Tests create/drop their own random schema; existing business rows are not changed.
# If omitted, the script uses the database configured above.
# TEST_DATABASE_URL="postgresql://postgres:URL_ENCODED_PASSWORD@localhost:5432/apag?schema=public"

# Observability (GET /metrics is raw OpenMetrics, outside /api/v1)
# Empty token permits loopback scrapes only; remote Prometheus must use a dedicated token.
METRICS_ENABLED=true
METRICS_TOKEN=
DB_SLOW_QUERY_MS=500
OTEL_ENABLED=false
OTEL_SERVICE_NAME=apag-backend
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_TRACES_SAMPLER_ARG=0.1

# Local exports: single API instance, output files expire after retention.
REPORT_EXPORT_DIR=.local/report-exports
REPORT_RETENTION_SECONDS=86400
