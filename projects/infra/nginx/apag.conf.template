map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

map $http_x_forwarded_proto $forwarded_proto {
    https   https;
    default $scheme;
}

log_format apag '$request_method $status upstream=$upstream_addr '
                'upstream_status=$upstream_status request_time=$request_time';

upstream apag_api {
    zone apag_api 64k;
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    resolver_timeout 3s;

    # Nginx round-robin distributes requests across the IPs returned by DNS.
    server ${APAG_UPSTREAM_HOST}:${APAG_UPSTREAM_PORT} resolve max_fails=1 fail_timeout=10s;
    keepalive 16;
}

server {
    listen 0.0.0.0:${PORT};
    server_name _;
    access_log /dev/stdout apag;

    client_max_body_size 25m;

    location / {
        proxy_pass http://apag_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_connect_timeout 3s;
        proxy_read_timeout 180s;
        proxy_next_upstream off;
    }
}
