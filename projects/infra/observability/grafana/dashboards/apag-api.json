{
  "uid": "apag-phase2",
  "title": "APAG \u2014 API Observability",
  "schemaVersion": 41,
  "version": 1,
  "tags": [
    "apag",
    "observability"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "RPS",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{service=\"$service\",instance=~\"$instance\",path=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "RPS",
          "exemplar": true,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "HTTP p50",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket{service=\"$service\",instance=~\"$instance\",path=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "HTTP p50",
          "exemplar": true,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "HTTP p95",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{service=\"$service\",instance=~\"$instance\",path=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "HTTP p95",
          "exemplar": true,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "HTTP p99",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{service=\"$service\",instance=~\"$instance\",path=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "HTTP p99",
          "exemplar": true,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "HTTP 5xx error rate",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_errors_total{service=\"$service\",instance=~\"$instance\",path=~\"$route\",status=~\"5..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(http_requests_total{service=\"$service\",instance=~\"$instance\",path=~\"$route\"}[$__rate_interval])), 0.000000001)",
          "legendFormat": "HTTP 5xx error rate",
          "exemplar": true,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "HTTP errors by status",
      "type": "timeseries",
      "description": "Includes 4xx and 5xx; permission/workflow errors are separate from server failures.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_errors_total{service=\"$service\",instance=~\"$instance\",path=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "HTTP errors by status",
          "exemplar": true,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "CPU \u2014 cores consumed",
      "type": "timeseries",
      "description": "1 means one fully consumed core; measured between scrapes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_cpu_usage{service=\"$service\",instance=~\"$instance\"}",
          "legendFormat": "CPU \u2014 cores consumed",
          "exemplar": true,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Process RAM \u2014 RSS",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_memory_usage{service=\"$service\",instance=~\"$instance\"}",
          "legendFormat": "Process RAM \u2014 RSS",
          "exemplar": true,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "Event loop delay",
      "type": "timeseries",
      "description": "Mean delay measured with 20ms sampling resolution; process CPU helps distinguish CPU pressure from external wait.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "event_loop_lag{service=\"$service\",instance=~\"$instance\"}",
          "legendFormat": "Event loop delay",
          "exemplar": true,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "title": "DB pool connections",
      "type": "timeseries",
      "description": "Actual per-process pg.Pool counts. Budget API pools + worker pools + rolling overlap against PostgreSQL connection headroom; defaults API max=10, Compose worker max=3.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "db_pool_total{service=\"$service\",instance=~\"$instance\"}",
          "legendFormat": "total {{instance}}",
          "exemplar": true,
          "range": true
        },
        {
          "refId": "B",
          "expr": "db_pool_idle{service=\"$service\",instance=~\"$instance\"}",
          "legendFormat": "idle {{instance}}",
          "exemplar": true,
          "range": true
        },
        {
          "refId": "C",
          "expr": "db_pool_waiting{service=\"$service\",instance=~\"$instance\"}",
          "legendFormat": "waiting {{instance}}",
          "exemplar": true,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "title": "DB pool checkout p95",
      "type": "timeseries",
      "description": "Checkout p95 per instance, so a saturated API/worker pool is visible when multiple instances are selected.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (instance, le) (rate(db_pool_acquire_duration_seconds_bucket{service=\"$service\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{instance}} checkout p95",
          "exemplar": true,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 12,
      "title": "PostgreSQL query p95",
      "type": "timeseries",
      "description": "SQL text and parameters are excluded; use trace exemplars to locate the operation.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(db_query_duration_seconds_bucket{service=\"$service\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "PostgreSQL query p95",
          "exemplar": true,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 13,
      "title": "Slow queries / second",
      "type": "timeseries",
      "description": "Threshold is DB_SLOW_QUERY_MS (default 500ms); correlated JSON log event=db.slow_query.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation) (rate(db_slow_queries_total{service=\"$service\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "Slow queries / second",
          "exemplar": true,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 14,
      "title": "WebSocket connections",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "active_websocket_connections{service=\"$service\",instance=~\"$instance\"}",
          "legendFormat": "WebSocket connections",
          "exemplar": true,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 15,
      "title": "Queue depth",
      "type": "timeseries",
      "description": "queue=none is explicitly zero because this application has no queue backend yet.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "queue_jobs_waiting{service=\"$service\",instance=~\"$instance\"}",
          "legendFormat": "Queue depth",
          "exemplar": true,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 16,
      "title": "Queue failed jobs",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "queue_jobs_failed{service=\"$service\",instance=~\"$instance\"}",
          "legendFormat": "Queue failed jobs",
          "exemplar": true,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 17,
      "title": "Queue execution p95",
      "type": "timeseries",
      "description": "No data until a real queue adapter invokes observeJob().",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 40,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, queue) (rate(queue_job_duration_bucket{service=\"$service\",instance=~\"$instance\",queue!=\"none\"}[$__rate_interval])))",
          "legendFormat": "Queue execution p95",
          "exemplar": true,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 18,
      "title": "Queue availability",
      "type": "stat",
      "description": "0 with queue=none means no queue installed; a registered queue at 0 means snapshot unavailable.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 40,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "queue_enabled{service=\"$service\",instance=~\"$instance\"}",
          "legendFormat": "Queue availability",
          "exemplar": true,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 19,
      "title": "Tracing export enabled",
      "type": "stat",
      "description": "Use Grafana Explore \u2192 Tempo. HTTP/DB histogram exemplars link traceId to the same trace.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tracing_enabled{service=\"$service\",instance=~\"$instance\"}",
          "legendFormat": "Tracing export enabled",
          "exemplar": true,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 20,
      "title": "Scrape availability",
      "type": "stat",
      "description": "If down, check the metrics token, target address and backend process before interpreting a missing series.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 48,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"apag-backend\",instance=~\"$instance\"}",
          "legendFormat": "Scrape availability",
          "exemplar": true,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(http_requests_total,service)",
        "current": {
          "text": "apag-backend",
          "value": "apag-backend"
        },
        "refresh": 1
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(up{job=\"apag-backend\"},instance)",
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1
      },
      {
        "name": "route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(http_requests_total,path)",
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1
      }
    ]
  },
  "links": [
    {
      "title": "Explore traces (Tempo)",
      "url": "/explore",
      "type": "link",
      "targetBlank": true
    }
  ]
}
