datasource db {
  provider = "postgresql"
}

generator client {
  provider        = "prisma-client"
  output          = "../../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["relationJoins"]
}

// ============================================================
// Enums
// ============================================================

enum UserRole {
  admin // Phòng Đào tạo / quản trị hệ thống
  student // Sinh viên tự đánh giá
  class_leader // Lớp trưởng đánh giá bước lớp
  advisor // Cố vấn học tập duyệt lớp
  faculty // Khoa gửi danh sách lên Phòng Đào tạo
  training_department // Phòng Đào tạo phê duyệt cuối
}

enum FormStatus {
  draft // Sinh viên đang điền
  submitted // SV đã nộp, chờ BCS/CVHT duyệt
  class_leader_approved // Lớp trưởng đã gửi danh sách lên CVHT
  class_approved // CVHT đã chấm, chờ Khoa gửi lên PĐT
  faculty_approved // Khoa đã gửi danh sách lên PĐT
  finalized // PĐT phê duyệt - kết quả chính thức
  rejected // Trả về chỉnh sửa
}

enum EvalRank {
  excellent
  good
  fair
  average
  weak
  poor
}

enum SemesterNo {
  SEMESTER_1 @map("1")
  SEMESTER_2 @map("2")
  summer
}

enum CriteriaInputType {
  combobox // Chọn 1 trong nhiều mức điểm
  checkbox // Tick đạt/không đạt
  textbox // Sinh viên tự nhập điểm
  deduction // Phần trừ điểm
}

// ============================================================
// Tables (Models)
// ============================================================

// 1. Users - tất cả actor dùng chung bảng, phân biệt qua role
// Username chuẩn hóa còn có expression unique index users_username_normalized_key trong SQL.
model User {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username              String    @unique @db.VarChar(50) // Định danh đăng nhập - chữ thường, số, chấm, gạch dưới/ngang
  email                 String    @unique @db.VarChar(255) // Thông tin liên hệ - không còn dùng để đăng nhập
  passwordHash          String    @map("password_hash") @db.VarChar(255)
  role                  UserRole  @default(student)
  fullName              String    @map("full_name") @db.VarChar(255)
  phone                 String?   @db.VarChar(20)
  dateOfBirth           DateTime? @map("date_of_birth") @db.Date
  isActive              Boolean   @default(true) @map("is_active")
  // Lưu ý: Chuỗi hash SHA-256 có độ dài cố định là 64 ký tự hex, 
  // nên sửa VarChar(255) thành VarChar(64) để tiết kiệm dung lượng bộ nhớ lưu trữ
  refreshTokenHash      String?   @map("refresh_token_hash") @db.VarChar(64)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz
  lockedAt              DateTime? @map("locked_at") @db.Timestamptz // Thời điểm admin khóa tài khoản (đồng bộ với isActive=false)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz // BỎ @default(now())
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz // Xóa mềm - null nghĩa là tài khoản còn hoạt động

  // Relations
  classStudents            ClassStudent[]
  advisorAssignments       AdvisorAssignment[]
  classLeaderAssignments   ClassLeaderAssignment[]
  evaluationForms          EvaluationForm[]      @relation("StudentForms")
  classLeaderReviewedForms EvaluationForm[]      @relation("ClassLeaderReviewer")
  classReviewedForms       EvaluationForm[]      @relation("ClassReviewer")
  adminFinalizedForms      EvaluationForm[]      @relation("AdminFinalizer")
  posts                    Post[]
  evidences                Evidence[]
  notifications            Notification[]
  passwordResetTokens      PasswordResetToken[]
  facultyAssignment        FacultyAssignment?

  // username đã @unique nên tự có index - đây là cột dùng để đăng nhập siêu nhanh.
  // Giữ nguyên index email cho các tra cứu liên hệ/báo cáo khác (ngoài phạm vi đổi login).
  @@index([email])
  // EXPLAIN benchmark: đọc đúng thứ tự trước LIMIT, tránh dựng JSON cho 10k sinh viên.
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "users_created_at_id_idx")
  @@map("users")
}

model Post {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String   @db.VarChar(255)
  content   String   @db.Text
  authorId  String   @map("author_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz // BỎ @default(now())

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@map("posts")
}

// Token quên mật khẩu chỉ lưu hash, không lưu token gốc đã gửi qua email.
model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// Phân quyền tài khoản khoa cho một khoa cụ thể.
model FacultyAssignment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @unique @map("user_id") @db.Uuid // role = faculty
  facultyId  String   @map("faculty_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@index([facultyId])
  @@map("faculty_assignments")
}

// 2. Khoa
model Faculty {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String    @unique @db.VarChar(20)
  name      String    @db.VarChar(255)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz // Xóa mềm - null nghĩa là khoa còn hoạt động

  // Relations
  majors             Major[]
  facultyAssignments FacultyAssignment[]

  @@map("faculties")
}

// 3. Ngành học
model Major {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String    @unique @db.VarChar(20)
  name      String    @db.VarChar(255)
  facultyId String    @map("faculty_id") @db.Uuid
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz // Xóa mềm - null nghĩa là ngành còn hoạt động

  // Relations
  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  classes Class[]

  // Indexes
  @@index([facultyId]) // Tối ưu khi lọc phiếu đánh giá theo Khoa (join qua Class → Major → Faculty)
  @@map("majors")
}

// 4. Lớp học
model Class {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String    @unique @db.VarChar(30)
  name           String    @db.VarChar(255)
  majorId        String    @map("major_id") @db.Uuid
  enrollmentYear Int       @map("enrollment_year") @db.SmallInt // CHECK: 2000-2100
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz // Xóa mềm - null nghĩa là lớp còn hoạt động

  // Relations
  major                   Major                    @relation(fields: [majorId], references: [id], onDelete: Cascade)
  classStudents           ClassStudent[]
  advisorAssignments      AdvisorAssignment[]
  classLeaderAssignments  ClassLeaderAssignment[]
  evaluationForms         EvaluationForm[]

  // Indexes
  @@index([majorId]) // Tối ưu khi tìm kiếm các lớp thuộc một Ngành học
  @@map("classes")
}

// 5. Danh sách lớp - sinh viên thuộc lớp nào
model ClassStudent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId     String   @map("class_id") @db.Uuid
  studentId   String   @unique @map("student_id") @db.Uuid
  studentCode String   @unique @map("student_code") @db.VarChar(20)
  enrolledAt  DateTime @default(now()) @map("enrolled_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz // Xóa mềm hồ sơ sinh viên - không đụng tới User

  // Relations
  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Constraints & Indexes
  @@unique([classId, studentId])
  @@map("class_students")
}

// 6. Phân quyền lớp trưởng cho lớp cụ thể - mỗi lớp trưởng chỉ phụ trách 1 lớp.
model ClassLeaderAssignment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @unique @map("user_id") @db.Uuid // role = class_leader
  classId    String   @map("class_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@map("class_leader_assignments")
}

// 7. Phân quyền CVHT cho lớp cụ thể
model AdvisorAssignment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid // role = advisor
  classId    String   @map("class_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([userId, classId])
  @@map("advisor_assignments")
}

// 8. Học kỳ
// Tối đa 1 isActive=true: partial unique index semesters_single_active_key trong SQL migration.
// Không dùng @unique trên isActive vì phải cho phép nhiều học kỳ inactive.
model Semester {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  year            Int        @db.SmallInt // CHECK: 2000-2100
  semester        SemesterNo
  startDate       DateTime   @map("start_date") @db.Date
  endDate         DateTime   @map("end_date") @db.Date
  studentDeadline DateTime?  @map("student_deadline") @db.Timestamptz // Hạn SV nộp phiếu
  classDeadline   DateTime?  @map("class_deadline") @db.Timestamptz // Hạn BCS/CVHT duyệt
  facultyDeadline DateTime?  @map("faculty_deadline") @db.Timestamptz // Hạn Khoa khóa dữ liệu
  isActive        Boolean    @default(false) @map("is_active")

  // Relations
  evaluationForms EvaluationForm[]

  @@unique([year, semester])
  @@map("semesters")
}

// 9. Tiêu chí đánh giá (cây phân cấp: I -> I.1 -> I.1.a)
model EvaluationCriteria {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String            @unique @db.VarChar(20)
  title       String            @db.VarChar(500)
  description String?           @db.Text
  maxScore    Int               @map("max_score") @db.SmallInt // CHECK: >= 0
  sortOrder   Int               @default(0) @map("sort_order") @db.SmallInt
  parentId    String?           @map("parent_id") @db.Uuid // Self-ref - cây phân cấp
  inputType   CriteriaInputType @default(combobox) @map("input_type")
  isActive    Boolean           @default(true) @map("is_active")

  // Relations
  parent             EvaluationCriteria?  @relation("CriteriaHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children           EvaluationCriteria[] @relation("CriteriaHierarchy")
  formCriteriaScores FormCriteriaScore[]
  formAttachments    FormAttachment[]
  evidences          Evidence[]

  @@map("evaluation_criteria")
}

// 10. Phiếu đánh giá - 1 phiếu / sinh viên / học kỳ
model EvaluationForm {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version    Int        @default(0) // Optimistic concurrency: tăng sau mỗi lần ghi phiếu
  studentId  String     @map("student_id") @db.Uuid
  classId    String     @map("class_id") @db.Uuid
  semesterId String     @map("semester_id") @db.Uuid
  status     FormStatus @default(draft)

  // Điểm 3 cấp
  studentScore Int?      @map("student_score") @db.SmallInt // SV tự chấm - CHECK: 0-100
  classScore   Int?      @map("class_score") @db.SmallInt // BCS/CVHT chấm - CHECK: 0-100
  finalScore   Int?      @map("final_score") @db.SmallInt // Học viện phê duyệt - CHECK: 0-100
  rank         EvalRank? // Tự tính từ final_score qua trigger

  note                String? @db.Text
  studyScore          Int     @default(0) @map("study_score") @db.SmallInt
  studyData           Json    @default("{}") @map("study_data")
  disciplineBaseScore Int     @default(25) @map("discipline_base_score") @db.SmallInt
  disciplineScore     Int     @default(0) @map("discipline_score") @db.SmallInt
  disciplineData      Json    @default("{}") @map("discipline_data")
  activityScore       Int     @default(0) @map("activity_score") @db.SmallInt
  activityData        Json    @default("{}") @map("activity_data")
  communityScore      Int     @default(0) @map("community_score") @db.SmallInt
  communityData       Json    @default("{}") @map("community_data")
  roleScore           Int     @default(0) @map("role_score") @db.SmallInt
  roleData            Json    @default("{}") @map("role_data")

  // Audit trail - ai duyệt ở từng bước
  classLeaderReviewedBy String? @map("class_leader_reviewed_by") @db.Uuid // lớp trưởng gửi lên CVHT
  classReviewedBy       String? @map("class_reviewed_by") @db.Uuid // advisor duyệt
  adminFinalizedBy      String? @map("admin_finalized_by") @db.Uuid // admin phê duyệt cuối

  classLeaderReviewedAt DateTime? @map("class_leader_reviewed_at") @db.Timestamptz
  classReviewedAt       DateTime? @map("class_reviewed_at") @db.Timestamptz
  adminFinalizedAt      DateTime? @map("admin_finalized_at") @db.Timestamptz

  submittedAt DateTime? @map("submitted_at") @db.Timestamptz
  isLocked    Boolean   @default(false) @map("is_locked")
  lockedAt    DateTime? @map("locked_at") @db.Timestamptz
  lockedBy    String?   @map("locked_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz // BỎ @default(now())

  // Relations
  student             User                @relation("StudentForms", fields: [studentId], references: [id], onDelete: Cascade)
  class               Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  semester            Semester            @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  classLeaderReviewer User?               @relation("ClassLeaderReviewer", fields: [classLeaderReviewedBy], references: [id], onDelete: SetNull)
  classReviewer       User?               @relation("ClassReviewer", fields: [classReviewedBy], references: [id], onDelete: SetNull)
  adminFinalizer      User?               @relation("AdminFinalizer", fields: [adminFinalizedBy], references: [id], onDelete: SetNull)
  criteriaScores      FormCriteriaScore[]
  attachments         FormAttachment[]
  evidences           Evidence[]

  // Constraints & Indexes
  @@unique([studentId, semesterId])
  @@index([classId]) // Lấy toàn bộ danh sách phiếu điểm của 1 lớp để BCS/CVHT duyệt điểm nhanh
  // Đã đo trước/sau: timeline index giúp chỉ join dữ liệu của trang cần lấy.
  @@index([semesterId, submittedAt(sort: Desc), createdAt(sort: Desc)], map: "evaluation_forms_semester_listing_idx")
  @@index([semesterId, status]) // Lọc phiếu điểm theo trạng thái của từng học kỳ (Ví dụ: tìm các hồ sơ đang 'submitted' tại kì này)
  @@index([status]) // Tổng hợp số liệu dashboard / Thống kê hồ sơ tắc nghẽn
  @@map("evaluation_forms")
}

// 11. Điểm từng tiêu chí trong phiếu
model FormCriteriaScore {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  formId          String   @map("form_id") @db.Uuid
  criteriaId      String   @map("criteria_id") @db.Uuid
  studentScore    Int?     @map("student_score") @db.SmallInt // SV tự chấm - CHECK: >= 0
  classScore      Int?     @map("class_score") @db.SmallInt // BCS/CVHT chấm - CHECK: >= 0
  note            String?  @db.Text
  attachmentsMeta Json     @default("[]") @map("attachments_meta") // Metadata minh chứng
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  form     EvaluationForm     @relation(fields: [formId], references: [id], onDelete: Cascade)
  criteria EvaluationCriteria @relation(fields: [criteriaId], references: [id], onDelete: Cascade)

  // Constraints & Indexes
  @@unique([formId, criteriaId])
  @@index([criteriaId]) // Tối ưu khi tính toán tổng điểm hoặc phân tích phổ điểm theo tiêu chí cụ thể
  @@map("form_criteria_scores")
}

// 12. File đính kèm minh chứng - Chỉ có con người kiểm duyệt
model FormAttachment {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  formId        String @map("form_id") @db.Uuid
  criteriaId    String @map("criteria_id") @db.Uuid
  originalName  String @map("original_name") @db.VarChar(500)
  storageKey    String @map("storage_key") @db.VarChar(1000) // Đường dẫn lưu file trên server/S3
  mimeType      String @map("mime_type") @db.VarChar(100)
  fileSizeBytes Int    @map("file_size_bytes")

  // Trạng thái duyệt của Ban cán sự / Cố vấn học tập
  isApproved   Boolean? @map("is_approved") // NULL = Chưa duyệt | true = Hợp lệ | false = Bị từ chối
  rejectReason String?  @map("reject_reason") @db.Text // Lý do từ chối nếu minh chứng sai/mờ

  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz

  // Relations
  form     EvaluationForm     @relation(fields: [formId], references: [id], onDelete: Cascade)
  criteria EvaluationCriteria @relation(fields: [criteriaId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([formId]) // Đọc nhanh toàn bộ minh chứng của một form cụ thể khi tải trang chấm điểm
  @@index([criteriaId]) // Gom nhóm kiểm tra các tài liệu nộp vào cùng một mục tiêu chí công tác
  @@map("form_attachments")
}

// 13. Minh chứng ảnh do sinh viên upload lên cloud ở FE, BE chỉ lưu URL
model Evidence {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId        String           @map("student_id") @db.Uuid
  evaluationFormId String           @map("evaluation_form_id") @db.Uuid
  criterionId      String           @map("criterion_id") @db.Uuid
  imageUrl         String           @map("image_url") @db.VarChar(1000)
  publicId         String?          @map("public_id") @db.VarChar(500)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  student        User               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  evaluationForm EvaluationForm     @relation(fields: [evaluationFormId], references: [id], onDelete: Cascade)
  criterion      EvaluationCriteria @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([evaluationFormId])
  @@index([criterionId])
  @@map("evidences")
}

// 14. Thông báo nội bộ cho sinh viên khi phiếu bị trả về/chờ xử lý
model Notification {
  dedupeKey String? @unique @map("dedupe_key") @db.VarChar(64) // Hash recipient + business event
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String?  @db.VarChar(50)
  title     String   @db.VarChar(255)
  content   String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

// Receipt thành công; không chứa key thô hoặc token. Giữ receipt để retry cũ không chạy lại.
model OperationReceipt {
  scope       String   @id @db.VarChar(64)
  requestHash String   @map("request_hash") @db.VarChar(64)
  response    Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("operation_receipts")
}
